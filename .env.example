# Runtime
OSTAG_ENV=dev
OSTAG_LOG_LEVEL=INFO
OSTAG_DRY_RUN=true

# Product
OSTAG_BOT_NAME="OS Tag"
OSTAG_PLATFORM=feishu

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_USE_WEBSOCKET=true
FEISHU_CALLBACK_URL=
FEISHU_API_BASE_URL=https://open.feishu.cn
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_USE_WEBSOCKET=true
LARK_API_BASE_URL=https://open.larksuite.com

# DingTalk
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_API_BASE_URL=https://api.dingtalk.com
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Telegram (the webhook URL must be public HTTPS in production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_GROUP_ALLOWLIST=
TELEGRAM_ADMIN_IDS=

# Backend
OSTAG_BACKEND=mock
# options: mock, codex_cli, claude_cli, kimi_cli, openai_api
OPENAI_API_KEY=
OSTAG_OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=

# CLI backends
CODEX_BIN=codex
CLAUDE_BIN=claude
KIMI_BIN=kimi
OSTAG_AGENT_TIMEOUT_SECONDS=120
OSTAG_CODEX_UNSAFE_MODE=false
OSTAG_CLAUDE_UNSAFE_MODE=false
OSTAG_EXECUTOR_RUNTIME_ENABLED=false
OSTAG_KIMI_EXECUTOR_ENABLED=false
OSTAG_EXECUTOR_MAX_OUTPUT_BYTES=1048576
# Declare only executors independently confirmed in the active OSStack profile.
OSTAG_EXECUTOR_OSSTACK_REGISTERED=

# MFS
MFS_ENABLED=false
MFS_BIN=mfs
MFS_SERVER_URL=http://127.0.0.1:8000
MFS_ALLOWED_SCOPES=file://./context
MFS_MAX_RESULTS=8
OSTAG_MEMORY_ROOT=~/.mfs/ostag-memory

# Safety
OSTAG_MAX_INPUT_CHARS=12000
OSTAG_MAX_CONTEXT_CHARS=30000
OSTAG_ALLOW_SHELL=false
OSTAG_AUDIT_LOG=./logs/audit.log
OSTAG_GH_BIN=gh
OSTAG_GITHUB_DEFAULT_REPO=
OSTAG_GLAB_BIN=glab
OSTAG_GITLAB_DEFAULT_REPO=

# Isolated read-only query lane (remote channels require platform:chat_id entries)
OSTAG_QUERY_LANE_ENABLED=false
OSTAG_QUERY_LANE_CHANNELS=
OSTAG_QUERY_LANE_MAX_CONCURRENCY=4
OSTAG_QUERY_LANE_TIMEOUT_SECONDS=10
OSTAG_QUERY_LANE_RETRY_COUNT=1
OSTAG_QUERY_LANE_MAX_RESULT_BYTES=65536
OSTAG_NATIVE_DIAGNOSTIC_CARDS_ENABLED=false

# Governed multi-run workstreams (disabled by default)
OSTAG_WORKSTREAMS_ENABLED=false
OSTAG_WORKSTREAM_STORE_PATH=./logs/workstreams.sqlite3
OSTAG_WORKSTREAM_MAX_BATCH=25

# SHA-bound GitHub/GitLab completion evidence (read-only)
OSTAG_PROVIDER_EVIDENCE_ENABLED=false
OSTAG_PROVIDER_EVIDENCE_MAX_CHECKS=100

# Remote work monitor (disabled by default; never commit the instance secret)
OSTAG_MONITOR_ENABLED=false
OSTAG_MONITOR_INSTANCE_ID=local
OSTAG_MONITOR_INSTANCE_SECRET=
OSTAG_MONITOR_CENTRAL_URL=
OSTAG_MONITOR_SPOOL_DB=./logs/work_monitor_spool.sqlite3
OSTAG_MONITOR_REPORT_INTERVAL_SECONDS=30
OSTAG_MONITOR_COMMAND_POLL_SECONDS=10
OSTAG_MONITOR_OSSTACK_BIN=osstack
OSTAG_MONITOR_OSSTACK_REFERENCES=./logs/osstack_task_references.json
OSTAG_OPERATIONAL_REPORT_ENABLED=false
OSTAG_OPERATIONAL_REPORT_CONNECTOR_EVIDENCE_DIR=./release
OSTAG_OPERATIONAL_REPORT_MAX_ITEMS=100

# Copilot Relay local bridge (disabled by default; production URL must be HTTPS)
OSTAG_COPILOT_RELAY_ENABLED=false
OSTAG_COPILOT_RELAY_SERVER_ENABLED=true
OSTAG_COPILOT_RELAY_WRITE_ENABLED=false
OSTAG_COPILOT_STATUS_BOARD_ENABLED=false
OSTAG_COPILOT_RELAY_CANARY_SESSION_IDS=
OSTAG_COPILOT_RELAY_INSTANCE_ID=local
OSTAG_COPILOT_RELAY_SECRET=
OSTAG_COPILOT_RELAY_CENTRAL_URL=
OSTAG_COPILOT_RELAY_SPOOL_DB=./logs/copilot_relay_spool.sqlite3
OSTAG_COPILOT_RELAY_OSSTACK_BIN=osstack
OSTAG_COPILOT_RELAY_DEFAULT_REPO=
OSTAG_COPILOT_RELAY_POLL_INTERVAL_SECONDS=5
OSTAG_COPILOT_RELAY_MAX_TEXT_CHARS=4000

# Feishu / Lark auto Base ingestion
OSTAG_AUTO_BASE_ENABLED=true
OSTAG_AUTO_BASE_IDENTITY=user
OSTAG_AUTO_BASE_HISTORY_PAGE_SIZE=30
OSTAG_AUTO_BASE_CLI_TIMEOUT_SECONDS=120
OSTAG_AUTO_BASE_CREATE_TABLE_IF_MISSING=true
OSTAG_AUTO_BASE_DEFAULT_TABLE_NAME=需求池
OSTAG_AUTO_BASE_DEFAULT_BASE_TOKEN=
OSTAG_AUTO_BASE_DEFAULT_TABLE_ID=
OSTAG_AUTO_BASE_DOWNLOAD_DIR=tmp/ostag-auto-base
OSTAG_AUTO_BASE_WORKDIR=.
LARK_CLI_BIN=lark-cli
DWS_CLI_BIN=dws

# Cross-platform daily task boards (central server, Asia/Shanghai)
OSTAG_DAILY_TASK_BOARDS_ENABLED=false
OSTAG_DAILY_TASK_BOARD_POLL_SECONDS=30
OSTAG_DAILY_TASK_BOARD_MORNING_HOUR=9
OSTAG_DAILY_TASK_BOARD_EVENING_HOUR=18
OSTAG_DAILY_TASK_BOARD_RECORD_LIMIT=50
OSTAG_DAILY_TASK_BOARD_FEISHU_CHAT_ID=
OSTAG_DAILY_TASK_BOARD_FEISHU_BASE_TOKEN=
OSTAG_DAILY_TASK_BOARD_FEISHU_TABLE_ID=
OSTAG_DAILY_TASK_BOARD_FEISHU_TABLE_URL=
OSTAG_DAILY_TASK_BOARD_FEISHU_MANAGER_IDS=
OSTAG_DAILY_TASK_BOARD_DINGTALK_CHAT_ID=
OSTAG_DAILY_TASK_BOARD_DINGTALK_BASE_TOKEN=
OSTAG_DAILY_TASK_BOARD_DINGTALK_TABLE_ID=
OSTAG_DAILY_TASK_BOARD_DINGTALK_TABLE_URL=
OSTAG_DAILY_TASK_BOARD_DINGTALK_MANAGER_IDS=

# Ambient requirement dashboard (disabled by default)
OSTAG_AMBIENT_ENABLED=false
OSTAG_AMBIENT_CHAT_IDS=
OSTAG_AMBIENT_INTERVAL_SECONDS=300
OSTAG_AMBIENT_RECORD_LIMIT=200
OSTAG_AMBIENT_DAILY_BOARD_ENABLED=false
OSTAG_AMBIENT_DAILY_BOARD_HOUR=12
OSTAG_AMBIENT_DAILY_BOARD_WINDOW_MINUTES=60
OSTAG_AMBIENT_TIMEZONE=Asia/Shanghai
OSTAG_AMBIENT_DAILY_BOARD_GROUP_NAME="Dadao 投研交易 FDE"
OSTAG_AMBIENT_DAILY_BOARD_BASE_URL=
