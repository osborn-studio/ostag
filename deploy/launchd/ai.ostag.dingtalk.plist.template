<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.ostag.dingtalk</string>
  <key>WorkingDirectory</key><string>__OSTAG_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gilbertchen/.local/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>ostag.main</string>
    <string>--config</string>
    <string>.env.dingtalk</string>
    <string>--platform</string>
    <string>dingtalk</string>
    <string>--live</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__OSTAG_ROOT__/logs/launchd-dingtalk.out.log</string>
  <key>StandardErrorPath</key><string>__OSTAG_ROOT__/logs/launchd-dingtalk.err.log</string>
</dict>
</plist>
